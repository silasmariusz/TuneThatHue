# --- secrets: NEVER commit paired bridge credentials ---
config/hue-box.toml
*.ini

# --- internal dev notes (infra IPs / continuity) ---
HANDOFF.md

# --- Python ---
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# --- C build artifacts (binaries ship as GitHub Release assets) ---
*.o
*.obj
*.dll
*.exe
*.so
build/
dist/

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- QNAP qpkg build artifacts (assembled at build time, never commit) ---
qnap/shared/app/
qnap/shared/runtime/
qnap/build/
qnap/_pyruntime/
# signing keys - NEVER commit
qnap/ca_certs
qnap/certificate
qnap/private_key

# --- Windows build artifacts ---
# The foobar2000 SDK is fetched by tools/fetch_foobar_sdk.ps1; its licence lets us
# ship components built with it, but the SDK itself is not ours to redistribute.
foobar/sdk/
foobar/build_obj/
*.res
# link byproducts of building a DLL
*.exp
*.lib
# Installers + the packaged component ship as GitHub Release assets, not in git.
installers/Output/
*.fb2k-component
# Code-signing material must never be committed.
*.pfx
*.p12
# The app icon IS committed (installers and the .rc need it) - do not ignore *.ico.
qnap/icons/preview.png

# Assembled by installers/prepare-windows.ps1: a downloaded CPython and a downloaded
# ffmpeg. Build output, not source - the script fetches both.
runtime/python-win/
runtime/ffmpeg-*/
