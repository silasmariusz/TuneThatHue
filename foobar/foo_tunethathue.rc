#include <windows.h>
#include "resource.h"

IDD_CONFIG DIALOGEX 0, 0, 250, 176
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TuneThatHue - send audio to daemon"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Daemon IP:",        -1,        10,  12,  55, 10
    EDITTEXT        IDC_HOST,            70,  10, 120, 12,  ES_AUTOHSCROLL
    LTEXT           "Port:",             -1,        10,  30,  55, 10
    EDITTEXT        IDC_PORT,            70,  28,  55, 12,  ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Stream name:",      -1,        10,  48,  55, 10
    EDITTEXT        IDC_STREAM,          70,  46, 120, 12,  ES_AUTOHSCROLL
    PUSHBUTTON      "Test connection",   IDC_TEST,  70,  64, 120, 14
    LTEXT           "Status:",           -1,        10,  86,  55, 10
    LTEXT           "",                  IDC_STATUS,70,  86, 170, 18

    DEFPUSHBUTTON   "OK",                IDOK,     150, 110,  40, 14
    PUSHBUTTON      "Cancel",            IDCANCEL, 195, 110,  40, 14

    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 10, 132, 230, 1
    LTEXT           "TuneThatHue  (c) 2025-2026  Silas Mariusz Grzybacz",
                    IDC_CREDITS1, 10, 138, 230, 10
    LTEXT           "devspark.pl  -  published: forum.qnap.net.pl",
                    -1, 10, 150, 230, 10
    LTEXT           "QNAP app repo: myqnap.org",
                    IDC_CREDITS2, 10, 162, 230, 10
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x2L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Silas Mariusz Grzybacz - devspark.pl"
            VALUE "FileDescription",  "TuneThatHue - foobar2000 component"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "foo_tunethathue"
            VALUE "LegalCopyright",   "(c) 2025-2026 Silas Mariusz Grzybacz. forum.qnap.net.pl / myqnap.org"
            VALUE "OriginalFilename", "foo_tunethathue.dll"
            VALUE "ProductName",      "TuneThatHue"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
